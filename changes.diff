+  isPanorama: boolean,
+) => number = (state: RechartsRootState, id: GraphicalItemId, isPanorama: boolean): number => {
+  const waterfallSettings: WaterfallSettings | undefined = selectSynchronisedWaterfallSettings(state, id);
