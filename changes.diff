+
+export const selectAllWaterfallBarPositions: (
+  state: RechartsRootState,
+  id: GraphicalItemId,
+  isPanorama: boolean,
+) => ReadonlyArray<WaterfallBarWithPosition> | undefined = createSelector(
+  [
+    selectWaterfallBarSizeList,
